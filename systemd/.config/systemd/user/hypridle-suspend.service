[Unit]
Description=Battery-only idle suspend for Omarchy
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/hypridle -c %h/.config/hypr/hypridle-suspend.conf
Restart=on-failure

[Install]
WantedBy=graphical-session.target
